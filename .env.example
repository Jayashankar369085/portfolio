# ============================================================
# Public configuration for the portfolio + admin dashboard.
#
# These values are BROWSER-SAFE: the Supabase publishable (anon)
# key is designed to be shipped to the client and protected by
# Row Level Security, never by secrecy.
#
#   - Never put a service-role / secret key or the database
#     password in this file, in js/config.js, or in any commit.
#   - This is a static site (no build step), so the app reads
#     these values from js/config.js at runtime. Copy them into
#     js/config.js (and optionally define them in Vercel →
#     Settings → Environment Variables for documentation).
# ============================================================

# Supabase project URL (ap-northeast-1, Tokyo)
SUPABASE_URL=https://clnqsitwiqzmikjuistr.supabase.co

# Supabase publishable (anon) key — safe for the browser
SUPABASE_ANON_KEY=PASTE_YOUR_SUPABASE_PUBLISHABLE_KEY_HERE

# Public site origin (informational)
SITE_URL=https://jayashankar-p.vercel.app
